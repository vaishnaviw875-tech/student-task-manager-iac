# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is in .gitignore and must NOT be committed.

account_id        = "PASTE_YOUR_CLOUDFLARE_ACCOUNT_ID"
workers_subdomain = "your-subdomain"          # from <name>.workers.dev

worker_name       = "student-task-manager"
kv_namespace_name = "student_tasks"
environment       = "dev"                     # dev | test | production
app_title         = "Student Task Manager"
